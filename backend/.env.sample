# backend/.env.sample

# =========================================================
# ICT LIBRARY OFFICE - SAMPLE ENVIRONMENT CONFIG
# =========================================================
# =========================================================
# SERVER
# =========================================================
PORT=4000

JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET

PUBLIC_URL=http://localhost:4000

# =========================================================
# CORS
# =========================================================
CORS_ORIGIN=http://localhost:5173,http://YOUR_LOCAL_IP:5173,https://your-frontend-domain.com

# =========================================================
# DATABASE
# =========================================================

# Docker / Production Example
DATABASE_URL_LOCAL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@db:5432/YOUR_DB_NAME

# Cloud Database Example
DATABASE_URL_NEON=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=require

# =========================================================
# OPTIONAL LOCAL DB VARIABLES
# =========================================================
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=ict_library_db
# DB_PASSWORD=your_password
# DB_PORT=5432

# =========================================================
# REDIS
# =========================================================
REDIS_HOST=redis
REDIS_PORT=6379

# Development-only
DISABLE_REDIS=true

# =========================================================
# CCTV / AI STREAMING
# =========================================================

# Windows FFmpeg Example
FFMPEG_PATH=C:\path\to\ffmpeg\bin\ffmpeg.exe

# RTSP Camera Stream
RTSP_URL=rtsp://YOUR_CAMERA_USERNAME:YOUR_CAMERA_PASSWORD@YOUR_CAMERA_IP:554/stream1

# =========================================================
# ROUTER CONFIG
# =========================================================
ROUTER_HOST=192.168.X.X
ROUTER_USER=YOUR_ROUTER_USERNAME
ROUTER_PASS=YOUR_ROUTER_PASSWORD

# =========================================================
# DEVICE NETWORK INFO
# =========================================================
COMPUTER_IP_ADDRESS=192.168.X.X
COMPUTER_USERNAME=YOUR_COMPUTER_NAME

PHONE_IP_ADDRESS=192.168.X.X

# =========================================================
# EMAIL / SMTP
# =========================================================
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password

# =========================================================
# CLOUDFLARE TURNSTILE
# =========================================================
TURNSTILE_SITE_KEY=YOUR_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_SECRET_KEY

# =========================================================
# OPTIONAL TOOLS
# =========================================================

# ngrok http 4000
# ngrok tcp 22