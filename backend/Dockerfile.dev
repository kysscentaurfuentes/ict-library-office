# backend/Dockerfile.dev
# =========================================================
# DEVELOPMENT DOCKERFILE
# =========================================================
FROM node:20-alpine

WORKDIR /app

# Required for healthcheck curl
RUN apk add --no-cache curl

# Install dependencies
COPY package*.json ./

RUN npm install

# Copy source code
COPY . .

# Expose backend port
EXPOSE 4000

# Development mode with hot reload
CMD ["npm", "run", "dev"]